# Public hostname only (no scheme). deploy/configure-env.sh fills this from the VM IP.
APP_DOMAIN=veridex.203-0-113-10.sslip.io

# API + worker
PORT=4000
MONGODB_URI=mongodb://mongodb:27017/veridex
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace_with_generated_access_secret
JWT_REFRESH_SECRET=replace_with_generated_refresh_secret
CLIENT_URL=https://veridex.203-0-113-10.sslip.io
NEXT_PUBLIC_API_URL=https://veridex.203-0-113-10.sslip.io
ML_SERVICE_URL=http://ml:8000
WORKER_CONCURRENCY=1
ALERT_WEBHOOK=
ADMIN_EMAILS=
REDIS_RATE_LIMITER=redis
NODE_ENV=production

# Free Gemini profile. Create a free-tier key in Google AI Studio and do not
# attach billing if you need a hard $0 ceiling.
AI_API_KEY=replace_with_gemini_api_key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-3.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=384

# Pinecone Starter (free)
PINECONE_API_KEY=replace_with_pinecone_api_key
PINECONE_INDEX_NAME=veridex-kb

# ML internals
ENABLE_LOCAL_NLI=false
ELASTICSEARCH_URL=http://elasticsearch:9200
PIPELINE_VERSION=1.0.0
