# API + Worker
PORT=4000
MONGODB_URI=mongodb://mongodb:27017/veridex
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace_with_32_plus_char_access_secret
JWT_REFRESH_SECRET=replace_with_32_plus_char_refresh_secret
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
ML_SERVICE_URL=http://ml:8000
WORKER_CONCURRENCY=3
ALERT_WEBHOOK=
ADMIN_EMAILS=
REDIS_RATE_LIMITER=memory
NODE_ENV=development

# AI provider (OpenAI defaults; any OpenAI-compatible chat endpoint is supported)
AI_API_KEY=
AI_BASE_URL=
CHAT_MODEL=gpt-4o
# Backward-compatible fallback used when AI_API_KEY is empty
OPENAI_API_KEY=sk-replace_me
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
PINECONE_API_KEY=replace_me
PINECONE_INDEX_NAME=veridex-kb
ENABLE_LOCAL_NLI=false
PINECONE_ENVIRONMENT=
ELASTICSEARCH_URL=http://elasticsearch:9200
PIPELINE_VERSION=1.0.0
